# Copier en .env.local (jamais commité) et remplir après avoir créé le projet
# Supabase dédié (voir schéma SQL fourni séparément).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cron /api/cron/refresh (GitHub + Vercel) — voir vercel.json pour la fréquence
GITHUB_TOKEN=
VERCEL_TOKEN=
# Requis si les projets Vercel suivis appartiennent à une équipe (pas au
# compte personnel) — sinon l'API Vercel renvoie une liste de déploiements
# vide sans erreur. Team ID visible dans Vercel > Settings > General.
VERCEL_TEAM_ID=
CRON_SECRET=

# Hooks Claude Code (/api/hooks/session-end) — doit correspondre à HOOK_SECRET
# défini dans chaque dépôt (EDHEC AI, Internship-tracker, Spircle/*)
HOOK_SECRET=

# Connecteur MCP des saves Instagram (/api/mcp/<MCP_SECRET>) — 32 caractères minimum, uniquement
# [A-Za-z0-9_-], générés au hasard, sinon la route refuse tout. Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# À définir aussi sur Vercel (Settings > Environment Variables), puis redéployer.
MCP_SECRET=

# Accès personnel (Basic Auth) — laisser vide en dev local, définir en prod
DASHBOARD_USER=
DASHBOARD_PASS=
